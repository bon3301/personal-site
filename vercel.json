{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index"
        },
        {
            "source": "/blog/:slug/",
            "destination": "/blog/post/index.html"
        },
        {
            "source": "/blog/:slug",
            "destination": "/blog/post/index.html"
        }
    ]
}